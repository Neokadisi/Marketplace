# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/marketplace
DB_SSL=false
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
# El usuario que se registre con este correo será administrador
ADMIN_EMAIL=tucorreo@ejemplo.cl
# simulado = pago de prueba (NO usar en producción). flow = cobro real con Flow
PAGO_MODO=simulado
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Pruebas: https://sandbox.flow.cl/api   Real: https://www.flow.cl/api
FLOW_URL=https://sandbox.flow.cl/api
PRECIO_PUBLICACION=3000
PRECIO_DESTACADO=5000
# true = las publicaciones se aprueban solas; false = tú las apruebas desde el panel
AUTO_APROBAR=false
